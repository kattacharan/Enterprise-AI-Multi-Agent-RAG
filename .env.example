# OpenAI API Configuration (Optional - fallback mock agent available if not provided)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_TEMPERATURE=0.2

# Embedding Configuration (Hugging Face sentence-transformers model)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# Vector Store (FAISS) Configuration
FAISS_INDEX_DIR=data/vectorstore
TOP_K_RETRIEVAL=4
SIMILARITY_THRESHOLD=0.35

# SQLite Database
SQLITE_DB_PATH=sqlite:///./data/enterprise_assistant.db

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True
